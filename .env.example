# Internal Notion integration token. Share the Acknowledgements database with it.
# When set, the site reads live rows (Thank you message → blue bubbles).
NOTION_TOKEN=
NOTION_DATABASE_ID=8f01c38233dc4cf785a4cf035b74df96

# Password for Acknowledgements. Defaults to mmmm if unset.
ACKNOWLEDGEMENTS_PASSWORD=mmmm

# Required for Sunday Posties, visitor introductions, and dandelion wishes.
DATABASE_URL=

# Clerk keys are provisioned by the Vercel integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Only this Clerk account can open /admin.
ADMIN_EMAIL=

# Optional separate salt for one-way visitor IP hashes.
VISITOR_HASH_SECRET=

# Optional. Wishes database (title property Wish). Extra text columns: Location, Gender, Age.
DANDELION_DATABASE_ID=
