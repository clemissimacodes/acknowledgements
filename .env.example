# Internal Notion integration token. Share the Acknowledgements database with it.
# When set, the site reads live rows (Thank you message → blue bubbles).
NOTION_TOKEN=
NOTION_DATABASE_ID=8f01c38233dc4cf785a4cf035b74df96

# Required for Sunday Posties, visitor introductions, and dandelion wishes.
DATABASE_URL=

# Clerk keys are provisioned by the Vercel integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clemi Store payments. Stripe keys are provisioned by the Vercel integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Add after registering /api/shop/webhook in Stripe.
STRIPE_WEBHOOK_SECRET=

# Only this verified Google-backed Clerk account can open /controlroom.
ADMIN_EMAIL=

# Optional separate salt for one-way visitor IP hashes.
VISITOR_HASH_SECRET=

# Optional separate salt for private Google Calendar location hashes.
CALENDAR_LOCATION_HASH_SECRET=

# Required for the daily CIA discovery endpoint.
CRON_SECRET=

# Optional comma-separated CIA pricing targets: Publisher|https://example.com/pricing
CIA_PRICING_WATCHLIST=

# Optional CIA and Acknowledgements reader password. Defaults to mmmm.
CIA_PASSWORD=

# Optional. Wishes database (title property Wish). Extra text columns: Location, Gender, Age.
DANDELION_DATABASE_ID=
